# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Model IDs are read from here (not hardcoded). Check current availability and limits first.
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_EXTRACT=gemini-3.5-flash-lite
GEMINI_MODEL_ANALYST=gemini-3.5-flash-lite
# Optional: limit on AI calls per browser session (default 60)
# MAX_CALLS_PER_SESSION=25
